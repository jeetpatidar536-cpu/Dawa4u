# Copy this file to .env and fill in what you have. Everything is optional for local testing.

# Port the server listens on
PORT=3000

# development = OTP codes are shown on screen and payments run in test mode
# production  = needs a real SMS provider and Razorpay keys
NODE_ENV=development

# First admin login (used only the first time the database is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Create a demo pharmacy and rider on first run (1 = yes, 0 = no)
DEMO_DATA=1

# Vision AI prescription scanner (get a key at https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Razorpay online payments (UPI, cards, netbanking). Leave empty for test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
