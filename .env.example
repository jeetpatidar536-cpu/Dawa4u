# Copy to .env on the server. Never commit the real .env.
# Same value as in WordPress (WooCommerce → dawa4u partners → Services), at least 32 characters.
D4U_SECRET=
# The public address of the gateway (needs a DNS A record pointing at this server).
API_DOMAIN=api.dawa4u.in
ALLOWED_ORIGIN=https://dawa4u.in
# Weather and delivery promise
CITY_LAT=22.7196
CITY_LNG=75.8577
TARGET_MIN=30
RAIN_BUFFER_MIN=10
# Unpaid orders give back the stock they hold after this many seconds
HOLD_TTL_S=1800
